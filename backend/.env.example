# --- Server ---
PORT=5001

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=swara_weather

# --- Open-Meteo forecast (free, keyless) ---
OPENMETEO_API_HOST=api.open-meteo.com
OPENMETEO_FORECAST_PATH=/v1/forecast

# --- Open-Meteo Historical (Archive) API: commercial key, keep secret ---
OPENMETEO_API_KEY=PUT_YOUR_KEY_HERE
OPENMETEO_ARCHIVE_HOST=customer-archive-api.open-meteo.com
OPENMETEO_ARCHIVE_PATH=/v1/archive
