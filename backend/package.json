{
  "name": "swara-weather-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB backend for the Swara Weather Open-Meteo solar dashboard",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "import": "node scripts/importToMongo.js",
    "historical": "node scripts/historicalFetch.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "node-cron": "^4.6.0"
  }
}
